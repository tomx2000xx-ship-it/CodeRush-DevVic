{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coderush-devvic",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coderush-telegram",
      "database_id": "2c9e1bb7-6fdc-4f06-9a2c-0ed6fc323d6e"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *", "*/30 * * * *", "0 */2 * * *", "0 */3 * * *", "15 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
